# OpenRouter AI (optional — core pipeline works without it)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
# Recommended: OpenRouter Unified Image API (text-to-image, 16:9)
# List models: GET https://openrouter.ai/api/v1/images/models
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5

# AI settings
AI_ENABLED=true
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.2
AI_TIMEOUT=30

# Visualizations
VISUALIZATION_ENABLED=true
VISUALIZATION_MAX_IMAGES=3

# Frontend (development)
VITE_API_URL=http://localhost:8000
